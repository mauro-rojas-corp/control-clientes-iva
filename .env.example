# Copiá este archivo a `.env` y completá lo que uses. `.env` NO se sube al repo.

# --- Backend (obligatorio) ---
# URL de la implementación Web App de Apps Script.
VITE_BACKEND_URL=

# Token vigente del backend. No reutilices el token que estuvo en Git.
# Esta variable evita subirlo al repositorio, pero Vite la incorpora al bundle:
# la autorización real siempre debe ser validada por Apps Script.
VITE_API_TOKEN=

# --- Marangatu (opcional) ---
# Página de login que abre el botón de la tarjeta. Ya tiene un valor por defecto.
# VITE_MARANGATU_LOGIN_URL=https://marangatu.set.gov.py/eset/login

# ID de la extensión "Ekuatia Login" (chrome://extensions, "Modo desarrollador").
# Sin esto, el botón igual abre la página pero no autocompleta.
# El ID de una extensión descomprimida cambia por máquina: copialo de TU Chrome.
VITE_MARANGATU_EXT_ID=
