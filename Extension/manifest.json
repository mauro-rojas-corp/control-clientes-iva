{
  "manifest_version": 3,
  "name": "Ekuatia Login",
  "version": "2.2",
  "description": "Puente de Control Clientes: login y Formulario 120 en Marangatu, descarga de formularios IVA y envío de la ficha por WhatsApp Web",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://marangatu.set.gov.py/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ekuatia Login",
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "icons": {
    "128": "logo.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://control-clientes-iva.vercel.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://marangatu.set.gov.py/*"
      ],
      "js": [
        "descargaContent.js",
        "paginas.js",
        "relevamientoNav.js",
        "panelContent.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
