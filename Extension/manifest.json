{
  "manifest_version": 3,
  "name": "Ekuatia Login",
  "version": "1.7",
  "description": "Puente de acceso a Marangatu desde Control Clientes: login y carga del Formulario 120",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["https://marangatu.set.gov.py/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ekuatia Login",
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "icons": {
    "128": "logo.png"
  },
  "externally_connectable": {
    "matches": ["http://localhost/*"]
  }
}
